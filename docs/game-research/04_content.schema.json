{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purpose Academy choice content development contract",
  "description": "Illustrative MVP contract. JSON validation does not replace semantic, asset, translation, or domain review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "item_version", "qualification_scope"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "item_version": {"type": "string", "minLength": 1},
        "qualification_scope": {"type": "string", "minLength": 1}
      }
    },
    "nullable_approval": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/approval"}]},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "required", "status", "uri", "language", "accessible_text", "rights_status", "review"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["image", "audio"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["missing", "draft", "approved"]},
        "uri": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "accessible_text": {"type": "string", "minLength": 1},
        "rights_status": {"enum": ["unverified", "owned", "licensed", "restricted"]},
        "review": {"$ref": "#/$defs/nullable_approval"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
        "then": {"properties": {
          "uri": {"type": "string", "minLength": 1},
          "rights_status": {"enum": ["owned", "licensed"]},
          "review": {"$ref": "#/$defs/approval"}
        }}
      }]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label", "image_asset_id", "feedback"],
      "properties": {
        "option_id": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]},
        "image_asset_id": {"type": ["string", "null"]},
        "feedback": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"properties": {"label": {"type": "string", "minLength": 1}}},
        {"properties": {"image_asset_id": {"type": "string", "minLength": 1}}}
      ]
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "text", "review"],
      "properties": {
        "locale": {"type": "string", "minLength": 2},
        "text": {"type": "string", "minLength": 1},
        "review": {"$ref": "#/$defs/nullable_approval"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "version", "status", "stream", "concept_id", "objective", "activity_type", "evidence_dimension", "task_form", "safety_classification", "prompt", "options", "answer", "explanation", "assets", "translations", "approvals", "support_policy", "provenance"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["draft", "in_review", "published", "withdrawn"]},
        "stream": {"enum": ["construction", "logistics", "community_support"]},
        "concept_id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "activity_type": {"const": "choice"},
        "evidence_dimension": {"enum": ["recognition", "listening_comprehension", "contextual_use"]},
        "task_form": {"type": "string", "minLength": 1},
        "safety_classification": {"enum": ["ordinary", "safety_relevant", "safety_critical"]},
        "prompt": {
          "type": "object", "additionalProperties": false,
          "required": ["text", "primary_modality", "image_asset_id", "audio_asset_id"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "primary_modality": {"enum": ["text", "image", "audio"]},
            "image_asset_id": {"type": ["string", "null"]},
            "audio_asset_id": {"type": ["string", "null"]}
          },
          "allOf": [
            {"if": {"properties": {"primary_modality": {"const": "audio"}}}, "then": {"properties": {"audio_asset_id": {"type": "string", "minLength": 1}}}},
            {"if": {"properties": {"primary_modality": {"const": "image"}}}, "then": {"properties": {"image_asset_id": {"type": "string", "minLength": 1}}}}
          ]
        },
        "options": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/option"}},
        "answer": {
          "type": "object", "additionalProperties": false,
          "required": ["selection_mode", "correct_option_ids"],
          "properties": {
            "selection_mode": {"enum": ["single", "multiple"]},
            "correct_option_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "allOf": [{"if": {"properties": {"selection_mode": {"const": "single"}}}, "then": {"properties": {"correct_option_ids": {"maxItems": 1}}}}]
        },
        "explanation": {"type": "string", "minLength": 1},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "translations": {"type": "array", "items": {"$ref": "#/$defs/translation"}},
        "approvals": {
          "type": "object", "additionalProperties": false,
          "required": ["language", "domain", "accessibility", "safety"],
          "properties": {
            "language": {"$ref": "#/$defs/nullable_approval"},
            "domain": {"$ref": "#/$defs/nullable_approval"},
            "accessibility": {"$ref": "#/$defs/nullable_approval"},
            "safety": {"$ref": "#/$defs/nullable_approval"}
          }
        },
        "support_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["audio_replay_allowed", "transcript_changes_evidence", "independent_evidence_rule"],
          "properties": {
            "audio_replay_allowed": {"type": "boolean"},
            "transcript_changes_evidence": {"type": "boolean"},
            "independent_evidence_rule": {"type": "string", "minLength": 1}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "source_reference", "review_note"],
          "properties": {
            "kind": {"enum": ["supplied_source", "reviewer_authored", "development_demo"]},
            "source_reference": {"type": ["string", "null"]},
            "review_note": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "published"}}, "required": ["status"]},
        "then": {
          "properties": {
            "approvals": {"properties": {
              "language": {"$ref": "#/$defs/approval"},
              "domain": {"$ref": "#/$defs/approval"},
              "accessibility": {"$ref": "#/$defs/approval"}
            }},
            "assets": {"items": {
              "allOf": [
                {"$ref": "#/$defs/asset"},
                {"if": {"properties": {"required": {"const": true}}}, "then": {"properties": {"status": {"const": "approved"}}}}
              ]
            }},
            "translations": {"items": {"properties": {"review": {"$ref": "#/$defs/approval"}}}}
          },
          "allOf": [{
            "if": {"properties": {"safety_classification": {"enum": ["safety_relevant", "safety_critical"]}}},
            "then": {"properties": {"approvals": {"properties": {"safety": {"$ref": "#/$defs/approval"}}}}}
          }]
        }
      }]
    }
  }
}
